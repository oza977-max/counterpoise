{
  "name": "counterpoise",
  "private": true,
  "version": "0.17.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "scan:dist": "node scripts/scan-dist.mjs",
    "test": "cross-env NODE_OPTIONS=--no-experimental-webstorage vitest run",
    "test:watch": "cross-env NODE_OPTIONS=--no-experimental-webstorage vitest",
    "publish-site": "npm run build && bash scripts/publish-site.sh",
    "docs:rules": "node scripts/generate-rules-doc.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "idb": "^8.0.0",
    "js-yaml": "^5.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "uuid": "^14.0.1",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/js-yaml": "^4.0.9",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.3",
    "cross-env": "^7.0.3",
    "fake-indexeddb": "^6.0.0",
    "fast-check": "^4.9.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.2",
    "vite": "^8.1.3",
    "vitest": "^4.1.10"
  }
}
